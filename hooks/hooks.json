{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"${CLAUDE_PROJECT_DIR:-.}\"; if [ -f \"$d/package.json\" ] || [ -f \"$d/tsconfig.json\" ] || [ -f \"$d/pnpm-workspace.yaml\" ]; then cat \"${CLAUDE_PLUGIN_ROOT}/standards-digest.md\"; fi'"
          }
        ]
      }
    ]
  }
}
